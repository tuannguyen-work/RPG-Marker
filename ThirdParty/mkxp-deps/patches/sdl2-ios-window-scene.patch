-        UIWindow *uiwindow = [[SDL_uikitwindow alloc] initWithFrame:data.uiscreen.bounds];
+        /* Scene-based apps (all SwiftUI apps) never show a window without a scene:
+           attach ours to the app's active window scene when there is one. */
+        UIWindow *uiwindow = nil;
